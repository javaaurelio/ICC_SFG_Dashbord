  <!-- CC-3890 OWASP low risk defect resolution-->
  <Get name="sessionHandler">
  <Set name="httpOnly" type="boolean">true</Set>
  </Get>
  
  <!--MFT-11749 Disable stacktrace to hide inbuild web server details-->
  <Get name="errorHandler">
    <Call name="setShowStacks">
      <Arg type="boolean">false</Arg>  
    </Call>
  </Get>
  
  <Call name="insertHandler">
    <Arg>
      <New id="RequestLog" class="org.eclipse.jetty.server.Server">
        <Set name="requestLog">
          <New id="RequestLogImpl" class="org.eclipse.jetty.server.CustomRequestLog">
            <Arg>
			<New class="org.eclipse.jetty.server.AsyncRequestLogWriter">
			  <Arg>
				<Call name="resolvePath" class="org.eclipse.jetty.xml.XmlConfiguration">
				  <Arg><Property name="jetty.base"/></Arg>
				  <Arg>
					<Property name="jetty.requestlog.filePath">
					  <Default>
						<Property name="jetty.requestlog.dir" default="logs"/>/infra-icc-yyyy_mm_dd.request.log
					  </Default>
					</Property>
				  </Arg>
				</Call>
			  </Arg>

			  <Set name="filenameDateFormat"><Property name="jetty.requestlog.filenameDateFormat" default="yyyy_MM_dd"/></Set>
			  <Set name="timeZone"><SystemProperty name="log.timezone"/></Set>
			  <Set name="retainDays"><Property name="jetty.requestlog.retainDays" default="1"/></Set>
			  <Set name="append"><Property name="jetty.requestlog.append" default="true"/></Set>
			</New>
		  </Arg>

		  <!-- Format String -->
		  <Arg>
			<Property name="jetty.requestlog.formatString" deprecated="jetty.customrequestlog.formatString">
			  <Default>
				<Get class="org.eclipse.jetty.server.CustomRequestLog" name="EXTENDED_NCSA_FORMAT"/>
			  </Default>
			</Property>
		  </Arg>
          </New>
        </Set>
      </New>
    </Arg>
  </Call> 
  
